{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luz do Teclado",
  "version": "1.0.0",
  "identifier": "com.ezequiel.luzteclado",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Luz do Teclado",
        "width": 400,
        "height": 560,
        "resizable": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "Liga e desliga a luz do teclado",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
